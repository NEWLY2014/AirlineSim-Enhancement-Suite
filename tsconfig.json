{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleDetection": "legacy",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "chrome",
      "jquery"
    ],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "extension",
    "outDir": "build/extension",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "extension/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "extension/js/vendor"
  ]
}
