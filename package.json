{
  "name": "airlinesim-enhancement-suite",
  "version": "0.9.0-beta.16",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "build": "node scripts/build-extension.cts",
    "test": "npm run build && node --test test/*.test.cts",
    "package": "scripts/package-extension.sh",
    "test:browser": "npm run build && node --test test/browser/*.test.cts",
    "test:i18n": "npm run build && node scripts/audit-i18n.cts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "acorn": "^8.18.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
